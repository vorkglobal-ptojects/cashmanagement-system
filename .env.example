# Database Connection URL (SQLite or PostgreSQL)
# Local SQLite example:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://cms_user:cms_password@localhost:5432/cash_management?schema=public"

# Session HMAC signing secret (minimum 32 characters)
SESSION_SECRET="replace-with-a-cryptographically-secure-random-key"

# Node Environment
NODE_ENV="production"

# Server Port
PORT=3000

# Convex Cloud Configuration & Deploy Key (Production / Preview)
CONVEX_DEPLOY_KEY="prod:your-project-name|your-key"
NEXT_PUBLIC_CONVEX_URL="https://your-project-name.convex.cloud"
CONVEX_HTTP_ACTIONS_URL="https://your-project-name.convex.site"
